# Java class files
*.class

# Log files
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.ear

# Virtual machine crash logs
hs_err_pid*

# Gradle cache and wrappers
.gradle/
!gradle/wrapper/gradle-wrapper.jar

# IntelliJ IDEA
.idea/
*.iml
*.iws

# VS Code
.vscode/

# Eclipse
*.classpath
*.project
*.settings/

# OS-specific
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.swp
*~

# Templates
/src/main/resources/fonts/
/src/main/resources/images/ui/
/src/main/resources/images/user/*
!/src/main/resources/images/user/.gitkeep

# output
output/*
!output/.gitkeep

# chromascape secrets for individual developers
secrets.properties

# custom user scripts
/src/main/java/com/chromascape/scripts/*/
# FORK DIVERGENCE — do not include in an upstream PR.
# Upstream ignores script sub-folders so users' private scripts stay uncommitted. In this fork the
# scripts ARE the deliverable and must be versioned. This re-includes every sub-folder.
!/src/main/java/com/chromascape/scripts/*/
/scripts/*/

# VS Code Java extension build output
/bin/

# Ignore build directory, even though it was ignored before??
/build/